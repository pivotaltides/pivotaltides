# ----------------------------------------------------------------------
# TinaCloud credentials (FREE) — required only for the LIVE site + the
# real /admin login. Local `npm run dev` does NOT need these.
#
# 1. Go to https://app.tina.io and sign in with the pivotaltides GitHub account.
# 2. Create a project, connect the pivotaltides/pivotaltides repo.
# 3. Copy the Client ID and create a Read-Only Token.
# 4. Copy THIS file to a new file named ".env" and paste your real values below.
#    (".env" is git-ignored and never committed.)
# ----------------------------------------------------------------------

TINA_CLIENT_ID=your-tinacloud-client-id
TINA_TOKEN=your-tinacloud-readonly-token

# Optional. Which git branch Tina reads/writes. Defaults to "main".
# TIP for safe testing: point this at a throwaway branch (e.g. "tina-test")
# so any test posts you make while trying the real login do NOT touch main.
# TINA_BRANCH=tina-test
