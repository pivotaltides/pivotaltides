<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

{# Brand suffix only while the title still fits in a search result (~60 chars) #}
{% set shortTitle = title.split(":")[0] if ((title | length) > 45 and ":" in title) else title %}
{% set metaTitle = seoTitle or ((shortTitle + " · Pivotal Tides") if (shortTitle | length) <= 45 else shortTitle) %}
{% set metaDesc = metaDescription or description or excerpt or site.description %}
{% set metaImage = (image | assetUrl) or site.defaultImage %}
{% set absImage = metaImage if metaImage.startsWith("http") else (site.url + metaImage) %}
{% set canonical = site.url + page.url %}

<title>{{ metaTitle }}</title>
<meta name="description" content="{{ metaDesc }}">
<meta name="author" content="{{ author or site.author }}">
{% if tags and tags.length %}<meta name="keywords" content="{{ tags | join(", ") }}">{% endif %}
<meta name="robots" content="{{ 'noindex, follow' if noindex else 'index, follow' }}">
<meta name="theme-color" content="#f3f0ea">
{% if not noindex %}<link rel="canonical" href="{{ canonical }}">{% endif %}

<meta property="og:title" content="{{ metaTitle }}">
<meta property="og:description" content="{{ metaDesc }}">
<meta property="og:type" content="{{ "article" if pageType == "article" else "website" }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ absImage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ metaTitle }}">
<meta name="twitter:description" content="{{ metaDesc }}">
<meta name="twitter:image" content="{{ absImage }}">

<link rel="icon" href="{{ basePath }}/Assets/Circular Logo.png" type="image/png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ basePath }}/styles.css">

{% if pageType == "article" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ metaDesc | dump | safe }},
  "image": {{ absImage | dump | safe }},
  "datePublished": "{{ date | isoDate }}",
  "dateModified": "{{ date | isoDate }}",
  "url": {{ canonical | dump | safe }},
  "mainEntityOfPage": { "@type": "WebPage", "@id": {{ canonical | dump | safe }} },
  "author": { "@type": "Person", "name": {{ (author or site.author) | dump | safe }} },
  "publisher": {
    "@type": "Organization",
    "name": "Pivotal Tides",
    "logo": { "@type": "ImageObject", "url": "{{ site.url }}/Assets/Circular%20Logo.png" }
  }{% if tags and tags.length %},
  "keywords": {{ (tags | join(", ")) | dump | safe }}{% endif %}
}
</script>
{% elif page.url == "/blog/" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Blog",
      "name": "Pivotal Tides Journal",
      "description": {{ metaDesc | dump | safe }},
      "url": {{ canonical | dump | safe }},
      "publisher": { "@type": "Organization", "name": "Pivotal Tides", "url": "{{ site.url }}/" }{% if collections.posts and collections.posts.length %},
      "blogPost": [{% for post in collections.posts %}{ "@type": "BlogPosting", "headline": {{ post.data.title | dump | safe }}, "url": "{{ site.url }}{{ post.url }}", "datePublished": "{{ post.date | isoDate }}" }{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Journal", "item": {{ canonical | dump | safe }} }
      ]
    }
  ]
}
</script>
{% endif %}

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-NMJZ0STYKQ"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-NMJZ0STYKQ');
</script>
</head>

<body>

<header>
  <div class="container nav">
    <a href="{{ basePath }}/" class="logo">
      <span class="logo-mark">PIVOTAL TIDES</span>
      <span class="logo-tag">Therapy for Growth &amp; Healing</span>
    </a>
    <div class="nav-links">
      <a href="{{ basePath }}/">About</a>
      <a href="{{ basePath }}/services">Services</a>
      <a href="{{ basePath }}/approach">Approach</a>
      <a href="{{ basePath }}/rates">Rates &amp; FAQ</a>
      <a href="{{ basePath }}/blog/">Journal</a>
      <a href="{{ basePath }}/contact">Contact</a>
    </div>
    <button class="hamburger-btn" id="hamburger" aria-label="Menu" aria-controls="mobileNav">
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav class="mobile-nav-menu" id="mobileNav" aria-label="Mobile">
    <a href="{{ basePath }}/">About</a>
    <a href="{{ basePath }}/services">Services</a>
    <a href="{{ basePath }}/approach">Approach</a>
    <a href="{{ basePath }}/rates">Rates &amp; FAQ</a>
    <a href="{{ basePath }}/blog/">Journal</a>
    <a href="{{ basePath }}/contact">Contact</a>
  </nav>
</header>

{{ content | safe }}

<!-- FOOTER -->
<footer>
  <div class="footer-inner">
    <div>
      <img src="{{ basePath }}/Assets/Circular Logo.png" alt="Pivotal Tides" class="footer-logo-img">
      <div class="footer-title">Pivotal Tides · Therapy for Growth &amp; Healing</div>
      <p>Marriage and family therapy serving the Inland Empire &mdash; Murrieta, Temecula, and surrounding areas. Depth-oriented, insight-focused care for individuals and couples navigating life&rsquo;s pivotal moments.</p>
      <p style="margin-top:1.2rem;"><strong style="color:#f3e7d8;">(951) 395-6089</strong></p>
    </div>
    <div>
      <div class="footer-title">Pages</div>
      <div class="footer-links">
        <a href="{{ basePath }}/">Home</a>
        <a href="{{ basePath }}/services">Services</a>
        <a href="{{ basePath }}/approach">Approach</a>
        <a href="{{ basePath }}/rates">Rates &amp; FAQ</a>
        <a href="{{ basePath }}/blog/">Journal</a>
        <a href="{{ basePath }}/contact">Contact</a>
      </div>
    </div>
    <div>
      <div class="footer-title">Practice</div>
      <div class="footer-links">
        <a href="{{ basePath }}/rates">Fees &amp; Insurance</a>
        <a href="{{ basePath }}/support-groups">Support Groups</a>
        <a href="{{ basePath }}/privacy-policy">Privacy Policy</a>
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© 2026 Pivotal Tides · All Rights Reserved</span>
    <span>CA LMFT112463</span>
  </div>
</footer>

<script src="{{ basePath }}/script.js" defer></script>
</body>
</html>
